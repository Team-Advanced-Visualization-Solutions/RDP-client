# Standalone FreeRDP client build — single self-contained binary
# Usage:
#   make -f Makefile.standalone          # configure + build
#   make -f Makefile.standalone clean    # remove build dir
#   make -f Makefile.standalone install  # install to /usr/local/bin

BUILD_DIR := build/standalone
BINARY    := $(BUILD_DIR)/client/X11/xfreerdp-tavs
PREFIX    := /usr/local

.PHONY: all clean install

all: $(BINARY)

$(BINARY):
	cmake -B $(BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=$(PREFIX) \
		-DBUILD_SHARED_LIBS=OFF \
		-DWITH_SERVER=OFF \
		-DWITH_CLIENT=ON \
		-DWITH_CLIENT_COMMON=ON \
		-DWITH_CHANNELS=ON \
		-DWITH_X11=ON \
		-DWITH_XRENDER=ON \
		-DWITH_XCURSOR=ON \
		-DWITH_FFMPEG_HWACCEL=ON \
		-DWITH_JPEG=ON \
		-DWINPR_UTILS_IMAGE_PNG=ON \
		-DWINPR_UTILS_IMAGE_JPEG=ON \
		-DWINPR_UTILS_IMAGE_WEBP=ON \
		-DWITH_SOXR=ON \
		-DWITH_RDPEUDP=ON \
		-DWITH_OPUS=ON \
		-DWINPR_UTILS_IMAGE_DIBv5=ON \
		-DWITH_X11_MULTITOUCH_EMULATION=ON \
		-DCHANNEL_RDPECAM_CLIENT=ON \
		-DCHANNEL_RDPEMSC_CLIENT=ON \
		-DWITH_VERBOSE_WINPR_ASSERT=OFF
	cmake --build $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)

install: $(BINARY)
	install -Dm755 $(BINARY) $(PREFIX)/bin/xfreerdp-tavs
