prefix=@PKG_CONFIG_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@FREERDP_INCLUDE_DIR@
libs=-lrdp-client-base@FREERDP_API_VERSION@

Name: RDP-client-base
Description: RDP-client-base: common RDP client library
URL: https://github.com/
Version: @FREERDP_VERSION@
Requires: @FREERDP_CLIENT_PC_REQUIRES@
Requires.private: @FREERDP_CLIENT_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} ${libs}
Libs.private: @FREERDP_CLIENT_PC_LIBRARY_PRIVATE@
Cflags: -I${includedir}
