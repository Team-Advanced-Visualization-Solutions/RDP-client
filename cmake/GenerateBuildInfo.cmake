# RDP-client: Modern X11 RDP Client
# Generate build information (build date/time and builder) at build time.
#
# Invoked from a custom target on every build, so the embedded date/author
# always reflect the moment the binary was actually built.
#
# Usage:
#   cmake -DOUT=<path to version_buildinfo.h> -DFREERDP_BUILDER=<name> -P GenerateBuildInfo.cmake

if(NOT OUT)
  message(FATAL_ERROR "OUT is not set")
endif()

if(NOT FREERDP_BUILDER)
  set(FREERDP_BUILDER "$ENV{USER}")
endif()
if(NOT FREERDP_BUILDER)
  set(FREERDP_BUILDER "unknown")
endif()

string(TIMESTAMP FREERDP_BUILD_DATE "%Y-%m-%d %H:%M:%S")

file(WRITE ${OUT}
  "/* Generated by CMake at build time, do not edit. */\n"
  "#ifndef FREERDP_VERSION_BUILDINFO_H\n"
  "#define FREERDP_VERSION_BUILDINFO_H\n"
  "#define FREERDP_BUILD_DATE \"${FREERDP_BUILD_DATE}\"\n"
  "#define FREERDP_BUILDER \"${FREERDP_BUILDER}\"\n"
  "#endif /* FREERDP_VERSION_BUILDINFO_H */\n"
)
